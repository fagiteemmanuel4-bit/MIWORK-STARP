{
  "name": "strap-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "check": "node --check scripts/patch-iconv-lite.cjs && node --check server.mjs && node --check src/cloudflare-worker.js && node --check email.js && find public -maxdepth 1 -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "postinstall": "node scripts/patch-iconv-lite.cjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.16.3",
    "jose": "^6.1.0",
    "@neondatabase/auth": "0.7.0-beta",
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0"
  },
  "devDependencies": {},
  "overrides": {
    "better-auth": "^1.7.25",
    "@better-auth/drizzle-adapter": "^1.7.25",
    "zod": "^4.6.6"
  }
}
